{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "gun-orange", "name": "Gun Orange", "color": "#e65c0b" },
        { "slug": "gun-dark", "name": "Gun Dark", "color": "#242525" },
        { "slug": "gun-darker", "name": "Gun Darker", "color": "#171818" },
        { "slug": "gun-light", "name": "Gun Light", "color": "#f4f3f0" },
        { "slug": "gun-muted", "name": "Gun Muted", "color": "#bcbab5" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "0.875rem" },
        { "slug": "30", "name": "M", "size": "1.5rem" },
        { "slug": "40", "name": "L", "size": "2.25rem" },
        { "slug": "50", "name": "XL", "size": "3.5rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "gun-condensed",
          "name": "Gun Condensed",
          "fontFamily": "\"Roboto Condensed\", \"Arial Narrow\", \"Liberation Sans Narrow\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Mały", "size": "0.8125rem" },
        { "slug": "medium", "name": "Średni", "size": "1rem" },
        { "slug": "large", "name": "Duży", "size": "1.5rem" },
        { "slug": "x-large", "name": "Bardzo duży", "size": "clamp(2.7rem, 5vw, 4.125rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "text": "#f4f3f0"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--gun-condensed)",
      "lineHeight": "1.38"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "link": {
        "color": { "text": "inherit" },
        ":hover": { "color": { "text": "#f28a51" } }
      },
      "button": {
        "border": { "radius": "7px" },
        "color": { "background": "#c44700", "text": "#ffffff" },
        "typography": { "fontWeight": "700" },
        "spacing": { "padding": { "top": "0.7rem", "right": "1.4rem", "bottom": "0.7rem", "left": "1.4rem" } }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontSize": "1.75rem", "fontWeight": "700", "lineHeight": "1" }
      },
      "core/navigation": {
        "typography": { "fontSize": "0.875rem" }
      }
    }
  }
}
