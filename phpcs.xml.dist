<?xml version="1.0"?>
<ruleset name="Gun Resort One">
    <description>WordPress coding standards for the Gun Resort block theme.</description>

    <file>functions.php</file>
    <file>inc</file>
    <file>patterns</file>

    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <config name="minimum_supported_wp_version" value="7.0"/>

    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="gun-resort-one"/>
            </property>
        </properties>
    </rule>
</ruleset>
